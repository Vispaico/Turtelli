# ============================================================
# Turtelli 2.0 — Environment Configuration
# Copy to .env and fill in values
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
API_PORT=3001
ADMIN_PORT=3002

# --- Database ---
DATABASE_URL=postgresql://turtelli:turtelli@localhost:5432/turtelli
DATABASE_SSL=false

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Authentication ---
SESSION_SECRET=change-me-to-a-random-string
JWT_SECRET=change-me-to-another-random-string

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SIGNALS_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# --- Market Data ---
# Provider: polygon | alphavantage | yfinance (free)
MARKET_DATA_PROVIDER=polygon
POLYGON_API_KEY=...

# --- TimesFM (Research) ---
TIMESFM_API_KEY=...

# --- Email ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...
EMAIL_FROM=noreply@turtelli.com

# --- Monitoring ---
SENTRY_DSN=
GRAFANA_API_KEY=

# --- Admin ---
ADMIN_EMAIL=admin@turtelli.com

# --- AI Chat ---
OPENAI_API_KEY=sk-...

# --- Web Push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
